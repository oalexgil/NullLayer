{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nulllayer/policy-input.schema.json",
  "title": "NullLayer privacy drafting input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_name",
    "website_url",
    "country",
    "business_type",
    "privacy_contact",
    "target_regions",
    "personal_data_categories",
    "processing_purposes"
  ],
  "properties": {
    "company_name": { "type": "string", "minLength": 1 },
    "website_url": { "type": "string", "format": "uri" },
    "country": { "type": "string", "minLength": 1 },
    "business_type": { "type": "string", "minLength": 1 },
    "privacy_contact": { "type": "string", "minLength": 1 },
    "target_regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "personal_data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "processing_purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "data_categories"],
        "properties": {
          "purpose": { "type": "string", "minLength": 1 },
          "data_categories": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "legal_basis": {
            "type": ["string", "null"],
            "description": "Operator-supplied legal basis. Use null when not yet determined."
          }
        }
      }
    },
    "uses_cookies": { "type": "boolean" },
    "analytics_services": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "advertising_services": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "payment_processors": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "ai_services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "personal_data_sent"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "personal_data_sent": { "type": "boolean" }
        }
      },
      "default": []
    },
    "third_party_services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "data_categories": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "transfer_notes": { "type": ["string", "null"] }
        }
      },
      "default": []
    },
    "retention_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data_category", "rule"],
        "properties": {
          "data_category": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    },
    "international_transfers": { "type": ["string", "null"] },
    "children_or_minors": { "type": ["string", "null"] },
    "automated_decision_making": { "type": ["string", "null"] },
    "security_measures": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "notes_for_reviewer": { "type": ["string", "null"] }
  }
}
